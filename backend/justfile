# Use the shell available on Windows without requiring Git Bash or WSL.
set windows-shell := ["powershell.exe", "-NoLogo", "-Command"]

migrate:
    alembic upgrade head

make_migration msg: 
    uv run alembic revision --autogenerate -m "{{msg}}"

test:
    uv run pytest

# --- Desktop packaging ---------------------------------------------------

# Build the frontend SPA so it can be bundled into the desktop executable.
build-frontend:
    pnpm --dir ../frontend install
    pnpm --dir ../frontend generate

# Produce the single-file desktop executable (runs migrations + API + worker
# + serves the bundled SPA). Requires `build-frontend` to have run first.
package: build-frontend
    uv run --with pyinstaller pyinstaller run.spec --clean

# Build a ZIP edition that stores all writable data beside the executable.
package-portable: build-frontend
    uv run --with pyinstaller pyinstaller run-portable.spec --clean
    uv run python scripts/package_portable.py

# Run the unified launcher locally (dev): migrations + worker + API + open UI.
run-desktop:
    uv run python run.py